// Generated by scripts/src/build.ts from seg_priority/src/main.nr (the Mega app build, P2.28). Do not edit.
use l3x_exchange::{
    account::{account_leaf, AccountPriv, AccountPub, Activity, blind, enc_commitment},
    consts::{
        ACCOUNTS_HEIGHT, CLASS_USER, DS_ACCT_NODE, DS_ACTV_NODE, DS_WD_CHAIN, DS_WDSALT, KIND_DEPOSIT,
        KIND_FORCED_WITHDRAW, KIND_REGISTER, KIND_REKEY, LOG_PRIORITY, MAX_COLLATERAL, MAX_DEPOSIT, PPM, TAG_FULL,
        TAG_WD,
    },
    da::{absorb, emit_change, emit_full, open_segment, segment_nonce},
    params::Params,
    request::Request,
    state::State,
    trade::{equity, exposure_fresh, initial_margin},
    tree::{merkle_root, update},
    deposit_commitment, withdrawal_record,
};
use l3x_types::{DS_ACTION_LOG, hash::hash, NodeOutput, priority_next_head, Running};

global PR: u32 = 4;

/// Witness for one priority request.
struct Item {
    req: Request,
    /// Register: the new account's index. Otherwise the named account's index.
    account_index: u32,
    /// Deposit, ForcedWithdraw, Rekey: the account's current leaf preimage.
    acct_pub: AccountPub,
    acct_priv: AccountPriv,
    acct_path: [Field; ACCOUNTS_HEIGHT],
    /// Register: path of the empty activity slot. ForcedWithdraw and Rekey: the account's
    /// activity and its path.
    actv: Activity,
    actv_path: [Field; ACCOUNTS_HEIGHT],
    /// The account's encryption key; for a Rekey, the new one. The Bridge checked it against its
    /// commitment and delivered it to the operator, so every request is processable.
    k_enc: Field,
    /// Deposit: the amount and salt that open the request's amount commitment. The Bridge computed
    /// the commitment from this opening, checked the amount's range and delivered the opening to the
    /// operator by constrained delivery, so every deposit is processable.
    dep_amount: u64,
    dep_salt: Field,
}

/// Priority segment (SPEC.md §7.3, §12): executes the next `n` queued requests in order.
/// Register creates the next account with zero collateral and no positions; Deposit credits an
/// existing account or, if the account does not exist, refunds the depositor; ForcedWithdraw
/// withdraws an account's free collateral when its owner asked; Rekey replaces an account's master
/// authorization and encryption key when its owner asked. No request can be skipped, and a
/// request's own fields can never make the segment unprovable: an invalid request is consumed
/// without effect. Forced closes and cancellations go through seg_forced.
fn main(
    vk_tree_root: Field,
    params: Params,
    start: Running,
    state: State,
    n: u32,
    items: [Item; PR],
) -> return_data NodeOutput {
    assert(start.state == state.trees(), "state opening");
    assert(n <= PR, "too many requests");
    let mut end = start;
    for i in 0..PR {
        if i < n {
            let entry = items[i].req.entry();
            end.priority_head = priority_next_head(end.priority_head, entry);
            end.action_log = hash([DS_ACTION_LOG, end.action_log, entry, LOG_PRIORITY]);
        }
    }
    end.priority_cursor = start.priority_cursor + n as u64;
    let da_nonce = segment_nonce(start, end.action_log);
    end = open_segment(end, da_nonce);
    let mut st = state;
    for i in 0..PR {
        if i < n {
            let (st2, end2) = apply(st, end, items[i], da_nonce, params);
            st = st2;
            end = end2;
        }
    }
    end.state = st.trees();
    NodeOutput { config_hash: params.config(vk_tree_root), start, end, receipts_root: 0 }
}

fn apply(state: State, running: Running, w: Item, da_nonce: Field, params: Params) -> (State, Running) {
    let req = w.req;
    let mut st = state;
    let mut r = running;
    if (req.kind == KIND_REGISTER) | (req.kind == KIND_REKEY) {
        let (st2, r2) = republish(st, r, w, da_nonce);
        st = st2;
        r = r2;
    } else if req.kind == KIND_FORCED_WITHDRAW {
        let (st2, r2) = forced_withdraw(st, r, w, da_nonce, params);
        st = st2;
        r = r2;
    } else {
        assert(req.kind == KIND_DEPOSIT, "request kind not executed by this segment");
        // The queue holds only a commitment to the amount (SPEC.md §10.3).
        let amount = w.dep_amount;
        assert(deposit_commitment(amount as Field, w.dep_salt) == req.b, "deposit opening");
        assert(amount < MAX_DEPOSIT, "deposit amount out of range");
        let idx = req.a as u32;
        let exists = (idx as Field == req.a) & (idx < st.num_accounts);
        let mut credited = false;
        if exists {
            assert(w.account_index == idx, "deposit index");
            let old_leaf = account_leaf(w.acct_pub, w.acct_priv);
            // A credit that would take collateral out of range is refunded instead, so no deposit
            // can make the queue unprocessable.
            credited = w.acct_priv.collateral + (amount as i64) < MAX_COLLATERAL as i64;
            let mut leaf = old_leaf;
            let mut privv = w.acct_priv;
            if credited {
                assert(enc_commitment(w.k_enc) == w.acct_pub.enc_commitment, "k_enc does not open the commitment");
                privv.collateral = w.acct_priv.collateral + amount as i64;
                privv.blind = blind(w.k_enc, idx, da_nonce, r.da_len);
                leaf = account_leaf(w.acct_pub, privv);
            }
            st.accounts_root = update(DS_ACCT_NODE, st.accounts_root, idx, old_leaf, leaf, w.acct_path);
            if credited {
                r = emit_change(r, idx, leaf, privv, w.k_enc, da_nonce);
            }
        }
        if !credited {
            // No such account, or no room: refund to the deposit's refund_to (SPEC.md §10.4). The
            // depositor's secret salt keeps the record unguessable, and lets the depositor rebuild it.
            let record = withdrawal_record(req.c, amount, w.dep_salt, r.batch, r.withdrawals_count);
            r.withdrawals = hash([DS_WD_CHAIN, r.withdrawals, record]);
            r.withdrawals_count += 1;
            r = absorb(absorb(r, TAG_WD), record);
        }
    }
    (st, r)
}

/// Register and Rekey (SPEC.md §7.3) publish an account in full under a key the Bridge delivered to
/// the operator, sharing one account update, one activity update and one full DA entry.
/// - Register (a = master authorization, b = encryption-key commitment) creates the next account,
///   owned by the request's sender, with zero collateral, no positions and a new activity.
/// - Rekey (a = account index, b = master authorization, c = encryption-key commitment), if the
///   account exists and the request came from its owner, replaces the two and advances the key and
///   order epochs: every session key is revoked and every order cancelled at once. The account's
///   collateral and positions are unchanged. A Rekey from anyone else is consumed without effect.
fn republish(state: State, running: Running, w: Item, da_nonce: Field) -> (State, Running) {
    let req = w.req;
    let mut st = state;
    let mut r = running;
    let register = req.kind == KIND_REGISTER;
    let idx = if register { st.num_accounts } else { req.a as u32 };
    let exists = register | ((idx as Field == req.a) & (idx < st.num_accounts));
    if exists {
        assert(w.account_index == idx, "account index");
        let old_leaf = if register { 0 } else { account_leaf(w.acct_pub, w.acct_priv) };
        let old_actv = if register { 0 } else { w.actv.hash() };
        let applies = register | (w.acct_pub.owner == req.sender);
        let pubv = if register {
            AccountPub { owner: req.sender, master_auth: req.a, enc_commitment: req.b, class: CLASS_USER }
        } else {
            AccountPub { owner: w.acct_pub.owner, master_auth: req.b, enc_commitment: req.c, class: w.acct_pub.class }
        };
        let mut privv = if register { AccountPriv::empty(0) } else { w.acct_priv };
        let mut act = if register {
            Activity::new()
        } else {
            let mut revoked = w.actv.cancel_all();
            revoked.key_epoch = w.actv.key_epoch + 1;
            revoked
        };
        let mut leaf = old_leaf;
        let mut actv_hash = old_actv;
        if applies {
            assert(enc_commitment(w.k_enc) == pubv.enc_commitment, "k_enc does not open the commitment");
            privv.blind = blind(w.k_enc, idx, da_nonce, r.da_len);
            leaf = account_leaf(pubv, privv);
            actv_hash = act.hash();
        }
        // A Rekey that does not apply still proves the account's leaf and activity, so the owner
        // it was checked against is the account's.
        st.accounts_root = update(DS_ACCT_NODE, st.accounts_root, idx, old_leaf, leaf, w.acct_path);
        st.activity_root = update(DS_ACTV_NODE, st.activity_root, idx, old_actv, actv_hash, w.actv_path);
        if register {
            st.num_accounts = idx + 1;
        }
        if applies {
            r = emit_full(r, TAG_FULL, idx, leaf, pubv, privv, w.k_enc, da_nonce);
        }
    }
    (st, r)
}

/// ForcedWithdraw (SPEC.md §7.3): if the account exists and the request came from its owner,
/// withdraws all free collateral, max(0, min(collateral, equity − IM)), to the recipient in `b`.
/// Equity needs fresh indices wherever the account is exposed; otherwise nothing is free, and a
/// flat account needs none. A request that does not qualify is consumed without effect.
fn forced_withdraw(state: State, running: Running, w: Item, da_nonce: Field, params: Params) -> (State, Running) {
    let req = w.req;
    let mut st = state;
    let mut r = running;
    let idx = req.a as u32;
    let exists = (idx as Field == req.a) & (idx < st.num_accounts);
    if exists {
        assert(w.account_index == idx, "forced withdrawal index");
        assert(
            merkle_root(DS_ACTV_NODE, w.actv.hash(), idx, w.actv_path) == st.activity_root,
            "activity path",
        );
        let old = w.acct_priv;
        let mut amount: u64 = 0;
        if (w.acct_pub.owner == req.sender)
            & exposure_fresh(old, w.actv, st.markets, params.max_age, r.time) {
            let im = initial_margin(old, w.actv, st.markets, params);
            let im_units = ((im + (PPM as u128) - 1) / (PPM as u128)) as u64;
            let free = equity(old, st.markets) - im_units as i64;
            let limit = if free < old.collateral { free } else { old.collateral };
            if limit > 0 {
                amount = limit as u64;
            }
        }
        let old_leaf = account_leaf(w.acct_pub, old);
        let mut new_leaf = old_leaf;
        let mut p = old;
        if amount > 0 {
            assert(enc_commitment(w.k_enc) == w.acct_pub.enc_commitment, "k_enc does not open the commitment");
            p.collateral = old.collateral - amount as i64;
            p.blind = blind(w.k_enc, idx, da_nonce, r.da_len);
            new_leaf = account_leaf(w.acct_pub, p);
        }
        st.accounts_root = update(DS_ACCT_NODE, st.accounts_root, idx, old_leaf, new_leaf, w.acct_path);
        if amount > 0 {
            r = emit_change(r, idx, new_leaf, p, w.k_enc, da_nonce);
            let index = r.withdrawals_count;
            let salt = hash([DS_WDSALT, w.k_enc, r.batch as Field, index as Field]);
            let record = withdrawal_record(req.b, amount, salt, r.batch, index);
            r.withdrawals = hash([DS_WD_CHAIN, r.withdrawals, record]);
            r.withdrawals_count = index + 1;
            r = absorb(absorb(r, TAG_WD), record);
        }
    }
    (st, r)
}
