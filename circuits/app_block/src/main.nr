// Generated by scripts/src/build.ts from seg_block/src/main.nr (the Mega app build, P2.28). Do not edit.
use l3x_exchange::{
    account::Activity,
    book::{best_ask, best_bid, Order, Sibling},
    consts::{ACCOUNTS_HEIGHT, BOOK_HEIGHT, DS_ACTV_NODE, DS_BLOCK, LOG_BLOCK, LOG_ORACLE, MARKETS, MAX_PRICE, N_ORACLES, PPM},
    mark::tick,
    oracle_message,
    params::Params,
    sig::{assert_signed, Signature},
    state::State,
    tree::merkle_root,
    trigger::{due, highest_down, lowest_up, TriggerTop},
};
use l3x_types::{DS_ACTION_LOG, hash::hash, NodeOutput, Running};

/// Oracle updates per block segment.
global U: u32 = 4;

/// A side's best order at the moment of the tick, or a proof that the side is empty. The order's
/// owner's activity shows the order is live.
struct TopOfBook {
    has: bool,
    price: u32,
    seq: u64,
    order: Order,
    path: [Sibling; BOOK_HEIGHT],
    owner_actv: Activity,
    owner_actv_path: [Field; ACCOUNTS_HEIGHT],
}

/// A tick's mid uses only orders that can fill: neither void (its owner cancelled all since
/// placing it) nor expired at the block time. The operator removes dead orders first (seg_refresh).
fn assert_live(top: TopOfBook, activity_root: Field, block_time: u64) {
    if top.has {
        let o = top.order;
        assert(
            merkle_root(DS_ACTV_NODE, top.owner_actv.hash(), o.account_index, top.owner_actv_path) == activity_root,
            "top of book owner activity",
        );
        assert(o.epoch == top.owner_actv.epoch, "void order at the top of the book");
        assert(!o.expired(block_time), "expired order at the top of the book");
    }
}

struct OracleUpdate {
    market: u32,
    price: u64,
    external: u64,
    time: u64,
    signed: [bool; N_ORACLES],
    sigs: [Signature; N_ORACLES],
    bid: TopOfBook,
    ask: TopOfBook,
    /// The next trigger due as the mark rises, and as it falls (SPEC.md §6.5).
    up: TriggerTop,
    down: TriggerTop,
}

/// Block segment (SPEC.md §8.4, §9.1): opens an L3 block at `block_time` and applies up to U
/// index updates, each signed by at least `oracle_k` of the configured publishers. Every update is
/// a mark tick for its market: it proves the top of book, whose orders must be live, recomputes the
/// mark, accrues the premium and applies funding when an interval is due. It then proves the next
/// trigger due in each direction and sets the market's trigger_pending flag if either is due at
/// the new mark (SPEC.md §6.5). This is the only segment that advances L3 time, so a long gap is
/// always crossed by a block that carries nothing but oracle data.
fn main(
    vk_tree_root: Field,
    params: Params,
    start: Running,
    state: State,
    block_time: u64,
    n: u32,
    updates: [OracleUpdate; U],
) -> return_data NodeOutput {
    assert(start.state == state.trees(), "state opening");
    assert(block_time >= start.time, "time regressed");
    assert(n <= U, "too many oracle updates");
    assert(params.oracle_k > 0, "oracle threshold");
    let mut end = start;
    let mut st = state;
    end.time = block_time;
    end.action_log =
        hash([DS_ACTION_LOG, end.action_log, hash([DS_BLOCK, block_time as Field]), LOG_BLOCK]);
    let domain = params.domain();
    for i in 0..U {
        if i < n {
            let u = updates[i];
            assert(u.market < MARKETS, "market");
            let mp = params.markets[u.market];
            assert(mp.listed(), "market not listed");
            let msg = oracle_message(domain, u.market, u.price, u.external, u.time);
            let mut count: u32 = 0;
            for j in 0..N_ORACLES {
                if u.signed[j] {
                    assert_signed(params.oracle_pk_x[j], params.oracle_pk_y[j], u.sigs[j], msg);
                    count += 1;
                }
            }
            assert(count >= params.oracle_k, "not enough oracle signatures");
            let m = st.markets[u.market];
            assert(u.time > m.index_time, "stale oracle update");
            assert(u.time <= block_time, "oracle update from the future");
            assert((u.price > 0) & (u.price < MAX_PRICE), "oracle price out of range");
            assert((u.external > 0) & (u.external < MAX_PRICE), "external mark out of range");
            let old = m.index_price;
            if old != 0 {
                let diff = if u.price > old { u.price - old } else { old - u.price };
                assert(diff * PPM <= old * mp.max_jump_ppm, "oracle jump too large");
            }
            let bb = best_bid(m.book_root, u.bid.has, u.bid.price, u.bid.seq, u.bid.order, u.bid.path);
            let ba = best_ask(m.book_root, u.ask.has, u.ask.price, u.ask.seq, u.ask.order, u.ask.path);
            assert_live(u.bid, st.activity_root, block_time);
            assert_live(u.ask, st.activity_root, block_time);
            let mut ticked = tick(m, mp, params.funding_interval, u.price, u.external, u.time, bb, ba, block_time);
            let up = lowest_up(ticked.trigger_root, u.up);
            let down = highest_down(ticked.trigger_root, u.down);
            ticked.trigger_pending = due(up, down, ticked.mark_price);
            st.markets[u.market] = ticked;
            end.action_log = hash([DS_ACTION_LOG, end.action_log, msg, LOG_ORACLE]);
        }
    }
    end.state = st.trees();
    NodeOutput { config_hash: params.config(vk_tree_root), start, end, receipts_root: 0 }
}
